    {
      "mode": "managed",
      "type": "aws_cloudfront_function",
      "name": "redirect",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:cloudfront::658914799523:function/cf-redirect",
            "code": "// Example: https://github.com/aws-samples/amazon-cloudfront-functions/tree/main/url-rewrite-single-page-apps\nfunction handler(event) {\n    var request = event.request;\n    var host = request.headers.host.value;\n\n    if (host === \"clearbyte.com\") {\n        var response = {\n            statusCode: 301,\n            statusDescription: \"Moved Permanently\",\n            headers: {\n                \"location\": { \"value\": \"https://www.clearbyte.com\" }\n            }\n        };\n        return response;\n    }\n\n    // SvelteKit's static adapter prerenders \"/about\" to \"about.html\", so an\n    // extensionless request has to be rewritten or S3 returns 403.\n    var uri = request.uri;\n\n    if (uri === \"/\") {\n        request.uri = \"/index.html\";\n        return request;\n    }\n\n    // \"/about/\" and \"/about\" resolve to the same file.\n    if (uri.endsWith(\"/\")) {\n        uri = uri.slice(0, -1);\n    }\n\n    var lastSegment = uri.slice(uri.lastIndexOf(\"/\") + 1);\n    if (lastSegment.indexOf(\".\") === -1) {\n        uri = uri + \".html\";\n    }\n\n    request.uri = uri;\n\n    return request;\n}\n",
            "comment": "URL to redirect to WWW",
            "etag": "E3UN6WX5RRO2AG",
            "id": "cf-redirect",
            "key_value_store_associations": [],
            "live_stage_etag": "E3UN6WX5RRO2AG",
            "name": "cf-redirect",
            "publish": true,
            "runtime": "cloudfront-js-2.0",
            "status": "IN_PROGRESS"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA=="
        }
      ]
    },
